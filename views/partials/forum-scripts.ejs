  async function handleReaction(postId, commentId, reactionType) {
      try {
        const response = await fetch("http://localhost:3000/post-reaction", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            post_id: postId ?? null,
            comment_post_id: commentId ?? null,
            reaction_type: reactionType,
          }),
        });
        const redirect = await response.redirected ? { url: response.url } : null;
        if (redirect) {
          window.location.href = redirect.url;
          return;
        }
        const data = await response.json();
        // Update the UI based on the new reaction state
        if (data.reaction_type) {
          const likeButton = document.getElementById(`likeButton-${postId}`);
          const likeCount = document.getElementById(`likeCount-${postId}`);
          const dislikeButton = document.getElementById(`dislikeButton-${postId}`);
          const dislikeCount = document.getElementById(`dislikeCount-${postId}`);
          const commentLikeCount = document.getElementById(`commentLikeCount-${commentId}`);
          const commentDislikeCount = document.getElementById(`commentDislikeCount-${commentId}`);
          const commentLikeButton = document.getElementById(`commentLikeButton-${commentId}`);
        const commentDislikeButton = document.getElementById(`commentDislikeButton-${commentId}`);
          if (data.reaction_type === "like" || data.reaction_type === 'like_removed' || data.reaction_type === 'like_updated' || data.reaction_type === 'like_comment' || data.reaction_type === 'like_removed_comment' || data.reaction_type === 'like_updated_comment') {
            if (data.reaction_type === 'like_updated_comment') {
              // This means the user switched from dislike to like on a comment
              const currentDislikeCount = Number(commentDislikeCount.textContent);
              const newDislikeCount = currentDislikeCount - 1;
              commentDislikeCount.textContent = newDislikeCount;
              commentDislikeButton.classList.remove("reaction-color");

              const currentLikeCount = Number(commentLikeCount.textContent);
              const newLikeCount = currentLikeCount + 1;
              commentLikeCount.textContent = newLikeCount;
              commentLikeButton.classList.add("reaction-color");
              return;
            }
            if(data.reaction_type === 'like_comment') {
              // This means a like was added to a comment
              const currentLikeCount = Number(commentLikeCount.textContent);
              const newLikeCount = currentLikeCount + 1;
              commentLikeCount.textContent = newLikeCount;
              commentLikeButton.classList.add("reaction-color");
              return;
            }
                if (data.reaction_type === 'like_removed_comment') {
                // This means a like was removed from a comment
                const currentLikeCount = Number(commentLikeCount.textContent);
                const newLikeCount = currentLikeCount - 1;
                commentLikeCount.textContent = newLikeCount;
                commentLikeButton.classList.remove("reaction-color");
                return;
                }

            if (data.reaction_type === 'like_updated') {
               // This means the user switched from dislike to like
              const currentDislikeCount = Number(dislikeCount.textContent);
              const newDislikeCount = currentDislikeCount - 1;
              dislikeCount.textContent = newDislikeCount;
              dislikeButton.classList.remove("reaction-color");

              const currentLikeCount = Number(likeCount.textContent);
              const newLikeCount = currentLikeCount + 1;
              likeCount.textContent = newLikeCount;
              likeButton.classList.add("reaction-color");
              return;
            }
            if (data.reaction_type !== 'like') {
                const currentlikeCount = Number(likeCount.textContent);
                const newCount = currentlikeCount - 1;
                likeCount.textContent = newCount;
               likeButton.classList.remove("reaction-color");
               return;
            }
            const currentlikeCount = Number(likeCount.textContent);
            const newCount = currentlikeCount + 1;
            likeCount.textContent = newCount;
            likeButton.classList.add("reaction-color");
          } else if (data.reaction_type.includes("dislike") || data.reaction_type === 'dislike_removed' || data.reaction_type === 'dislike_updated' || data.reaction_type === 'dislike_removed_comment' || data.reaction_type === 'dislike_updated_comment') {
            if (data.reaction_type === 'dislike_updated_comment') {
              // This means the user switched from like to dislike on a comment
              const currentLikeCount = Number(commentLikeCount.textContent);
              const newLikeCount = currentLikeCount - 1;
              commentLikeCount.textContent = newLikeCount;
              commentLikeButton.classList.remove("reaction-color");

              const currentDislikeCount = Number(commentDislikeCount.textContent);
              const newDislikeCount = currentDislikeCount + 1;
              commentDislikeCount.textContent = newDislikeCount;
              commentDislikeButton.classList.add("reaction-color");
              return;
            }
            if (data.reaction_type === 'dislike_comment') {
              // This means a dislike was added to a comment
              const currentDislikeCount = Number(commentDislikeCount.textContent);
              const newDislikeCount = currentDislikeCount + 1;
              commentDislikeCount.textContent = newDislikeCount;
              commentDislikeButton.classList.add("reaction-color");
              return;
            }
                if(data.reaction_type === 'dislike_removed_comment') {
                // This means a dislike was removed from a comment
                const currentDislikeCount = Number(commentDislikeCount.textContent);
                const newDislikeCount = currentDislikeCount - 1;
                commentDislikeCount.textContent = newDislikeCount;
                commentDislikeButton.classList.remove("reaction-color");
                return;
                }

            if (data.reaction_type === 'dislike_updated') {
              // This means the user switched from like to dislike
              const currentLikeCount = Number(likeCount.textContent);
              const newLikeCount = currentLikeCount - 1;
              likeCount.textContent = newLikeCount;
              likeButton.classList.remove("reaction-color");

              const currentDislikeCount = Number(dislikeCount.textContent);
              const newDislikeCount = currentDislikeCount + 1;
              dislikeCount.textContent = newDislikeCount;
              dislikeButton.classList.add("reaction-color");
              return;
            }
            if (data.reaction_type !== 'dislike') {
                // This means a dislike was removed
                const currentDislikeCount = Number(dislikeCount.textContent);
               const newCount = currentDislikeCount - 1;
               dislikeCount.textContent = newCount;
               dislikeButton.classList.remove("reaction-color");
               return;
            }
            // This means a dislike was added
            const currentDislikeCount = Number(dislikeCount.textContent);
            const newCount = currentDislikeCount + 1;
            dislikeCount.textContent = newCount;
            dislikeButton.classList.add("reaction-color");
          }
        }
      } catch (err) {
        console.error("Error handling reaction:", err);
      }
    }

    document.addEventListener("DOMContentLoaded", () => {
      const list = <%- JSON.stringify(listAllContent) %>;
      if (!Array.isArray(list) || list.length === 0) return;

      listPosts(list);
    });
</script>
