    function toggleReplyBox(id, replying = false, panelType = null) {

        if (replying) {
          if(panelType === 'firstTier') {
            const replySection = document.getElementById(`replyInputBox-${id}`);
            replySection.style.display = replySection.style.display === "none" ? "block" : "none";
            return;
          }
          const finalReplyBox = document.getElementById(`finalReplyInputBox-${id}`);
          if (finalReplyBox.style.display === "block") {
            finalReplyBox.style.display = "none";
            return;
          } else {
            finalReplyBox.style.display = "block";
            return;
          }
        }
        const replyBox = document.getElementById(`replyInputBox-${id}`);
        replyBox.style.display = replyBox.style.display === "none" ? "block" : "none";
    }
    function showAllReplies(id, isFirstReplyTier, isSecondReplyTier, replied = false, panelType) {

      if (replied) {
        if (isSecondReplyTier) {
          const finalReplySection = document.getElementById(`finalReplyCommentInputBox-${id}`);
          if (finalReplySection.style.display === "block") {
            finalReplySection.style.display = "none";
            return;
          } else {
            finalReplySection.style.display = "block";
            return;
          }
        } else if (isFirstReplyTier) {
          const replySection = document.getElementById(`commentInputBox-${id}`);
          replySection.style.display = replySection.style.display === "none" ? "block" : "none";
        }
          else {
            const replySection = document.getElementById(`commentInputBox-${id}`);
            replySection.style.display = replySection.style.display === "none" ? "block" : "none";
          }
        }
        else {
          if (panelType === "secondTier") {
               const finalReplySection = document.getElementById(`finalReplyCommentInputBox-${id}`);
              finalReplySection.style.display = finalReplySection.style.display === "none" ? "block" : "none";
          } else if (panelType === "firstTier") {
          const replySection = document.getElementById(`commentInputBox-${id}`);
          replySection.style.display = replySection.style.display === "none" ? "block" : "none";
          }
        }
    }
      async function handleReplySubmit(postId, replyId, username) {

        let replyRoute;

        if (replyId && !postId) {
