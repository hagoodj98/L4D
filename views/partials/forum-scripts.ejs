                <div style="display: flex; align-items: center">
                  <form onsubmit="handleReaction('like', 'comment', ${newComment.id}); return false;">
                    <input
                      type="hidden"
                      name="comment_post_id"
                      value="${newComment.id}"
                    />
                    <input type="hidden" name="reaction_type" value="like" />
                    <button
                      id="commentLikeButton-${newComment.id}"
                      class="postButton  ${newComment.current_user_reaction === "like" ? "reaction-color" : ""} "
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
