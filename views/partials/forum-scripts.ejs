    async function handleReaction(postId, commentId, finalReplyId, reactionType) {
        try {
          const response = await fetch("http://localhost:3000/post-reaction", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              post_id: postId ?? null,
              comment_post_id: commentId ?? null,
              final_reply_id: finalReplyId ?? null,
              reaction_type: reactionType,
            }),
          });
          const redirect = await response.redirected ? { url: response.url } : null;
          if (redirect) {
            window.location.href = redirect.url;
            return;
          }
          const data = await response.json();
          // Update the UI based on the new reaction state
          if (data.reaction_type) {
            ///
            const likeButton = document.getElementById(`likeButton-${postId}`);
            const likeCount = document.getElementById(`likeCount-${postId}`);
            const dislikeButton = document.getElementById(`dislikeButton-${postId}`);
            const dislikeCount = document.getElementById(`dislikeCount-${postId}`);
            ///
            const commentLikeCount = document.getElementById(`commentLikeCount-${commentId}`);
            const commentDislikeCount = document.getElementById(`commentDislikeCount-${commentId}`);
            const commentLikeButton = document.getElementById(`commentLikeButton-${commentId}`);
            const commentDislikeButton = document.getElementById(`commentDislikeButton-${commentId}`);
            ///
            const finalReplyLikeCount = document.getElementById(`finalReplyLikeCount-${finalReplyId}`);
            const finalReplyDislikeCount = document.getElementById(`finalReplyDislikeCount-${finalReplyId}`);
            const finalReplyLikeButton = document.getElementById(`finalReplyLikeButton-${finalReplyId}`);
            const finalReplyDislikeButton = document.getElementById(`finalReplyDislikeButton-${finalReplyId}`);
            if (data.reaction_type === "like" || data.reaction_type === "like_final_reply" || data.reaction_type === "like_removed_final_reply" || data.reaction_type === "like_updated_final_reply" || data.reaction_type === 'like_removed' || data.reaction_type === 'like_updated' || data.reaction_type === 'like_comment' || data.reaction_type === 'like_removed_comment' || data.reaction_type === 'like_updated_comment') {
              if (data.reaction_type === 'like_updated_final_reply') {
                // This means the user switched from dislike to like on a final reply
                const currentDislikeCount = Number(finalReplyDislikeCount.textContent);
                const newDislikeCount = currentDislikeCount - 1;
                finalReplyDislikeCount.textContent = newDislikeCount;
                finalReplyDislikeButton.classList.remove("reaction-color");

                const currentLikeCount = Number(finalReplyLikeCount.textContent);
                const newLikeCount = currentLikeCount + 1;
                finalReplyLikeCount.textContent = newLikeCount;
                finalReplyLikeButton.classList.add("reaction-color");
                return;
              }
              if (data.reaction_type === 'like_final_reply') {
                // This means a like was added to a final reply
                const currentLikeCount = Number(finalReplyLikeCount.textContent);
                const newLikeCount = currentLikeCount + 1;
                finalReplyLikeCount.textContent = newLikeCount;
                finalReplyLikeButton.classList.add("reaction-color");
                return;
              }
              if (data.reaction_type === 'like_removed_final_reply') {
                // This means a like was removed from a final reply
                const currentLikeCount = Number(finalReplyLikeCount.textContent);
                const newLikeCount = currentLikeCount - 1;
                finalReplyLikeCount.textContent = newLikeCount;
                finalReplyLikeButton.classList.remove("reaction-color");
                return;
              }
              if (data.reaction_type === 'like_updated_comment') {
                // This means the user switched from dislike to like on a comment
                const currentDislikeCount = Number(commentDislikeCount.textContent);
                const newDislikeCount = currentDislikeCount - 1;
                commentDislikeCount.textContent = newDislikeCount;
                commentDislikeButton.classList.remove("reaction-color");

                const currentLikeCount = Number(commentLikeCount.textContent);
                const newLikeCount = currentLikeCount + 1;
                commentLikeCount.textContent = newLikeCount;
                commentLikeButton.classList.add("reaction-color");
                return;
              }
              if(data.reaction_type === 'like_comment') {
                // This means a like was added to a comment
                const currentLikeCount = Number(commentLikeCount.textContent);
                const newLikeCount = currentLikeCount + 1;
                commentLikeCount.textContent = newLikeCount;
                commentLikeButton.classList.add("reaction-color");
                return;
              }
              if (data.reaction_type === 'like_removed_comment') {
                // This means a like was removed from a comment
                const currentLikeCount = Number(commentLikeCount.textContent);
                const newLikeCount = currentLikeCount - 1;
                commentLikeCount.textContent = newLikeCount;
                commentLikeButton.classList.remove("reaction-color");
                return;
              }

              if (data.reaction_type === 'like_updated') {
                 // This means the user switched from dislike to like
                const currentDislikeCount = Number(dislikeCount.textContent);
                const newDislikeCount = currentDislikeCount - 1;
                dislikeCount.textContent = newDislikeCount;
                dislikeButton.classList.remove("reaction-color");

                const currentLikeCount = Number(likeCount.textContent);
                const newLikeCount = currentLikeCount + 1;
                likeCount.textContent = newLikeCount;
                likeButton.classList.add("reaction-color");
                return;
              }
              if (data.reaction_type !== 'like') {
                  const currentlikeCount = Number(likeCount.textContent);
                  const newCount = currentlikeCount - 1;
                  likeCount.textContent = newCount;
                 likeButton.classList.remove("reaction-color");
                 return;
              }
              const currentlikeCount = Number(likeCount.textContent);
              const newCount = currentlikeCount + 1;
              likeCount.textContent = newCount;
              likeButton.classList.add("reaction-color");
            } else if (data.reaction_type.includes("dislike") || data.reaction_type === 'dislike_final_reply' || data.reaction_type === 'dislike_removed_final_reply' || data.reaction_type === 'dislike_updated_final_reply' || data.reaction_type === 'dislike_removed' || data.reaction_type === 'dislike_updated' || data.reaction_type === 'dislike_removed_comment' || data.reaction_type === 'dislike_updated_comment') {
              if( data.reaction_type === 'dislike_updated_final_reply') {
                // This means the user switched from like to dislike on a final reply
                const currentLikeCount = Number(finalReplyLikeCount.textContent);
                const newLikeCount = currentLikeCount - 1;
                finalReplyLikeCount.textContent = newLikeCount;
                finalReplyLikeButton.classList.remove("reaction-color");

                const currentDislikeCount = Number(finalReplyDislikeCount.textContent);
                const newDislikeCount = currentDislikeCount + 1;
                finalReplyDislikeCount.textContent = newDislikeCount;
                finalReplyDislikeButton.classList.add("reaction-color");
                return;
              }
              if (data.reaction_type === 'dislike_final_reply') {
                // This means a dislike was added to a final reply
                const currentDislikeCount = Number(finalReplyDislikeCount.textContent);
                const newDislikeCount = currentDislikeCount + 1;
                finalReplyDislikeCount.textContent = newDislikeCount;
                finalReplyDislikeButton.classList.add("reaction-color");
                return;
              }
              if (data.reaction_type === 'dislike_removed_final_reply') {
                // This means a dislike was removed from a final reply
                const currentDislikeCount = Number(finalReplyDislikeCount.textContent);
                const newDislikeCount = currentDislikeCount - 1;
                finalReplyDislikeCount.textContent = newDislikeCount;
                finalReplyDislikeButton.classList.remove("reaction-color");
                return;
              }
              if (data.reaction_type === 'dislike_updated_comment') {
                // This means the user switched from like to dislike on a comment
                const currentLikeCount = Number(commentLikeCount.textContent);
                const newLikeCount = currentLikeCount - 1;
                commentLikeCount.textContent = newLikeCount;
                commentLikeButton.classList.remove("reaction-color");

                const currentDislikeCount = Number(commentDislikeCount.textContent);
                const newDislikeCount = currentDislikeCount + 1;
                commentDislikeCount.textContent = newDislikeCount;
                commentDislikeButton.classList.add("reaction-color");
                return;
              }
              if (data.reaction_type === 'dislike_comment') {
                // This means a dislike was added to a comment
                const currentDislikeCount = Number(commentDislikeCount.textContent);
                const newDislikeCount = currentDislikeCount + 1;
                commentDislikeCount.textContent = newDislikeCount;
                commentDislikeButton.classList.add("reaction-color");
                return;
              }
              if(data.reaction_type === 'dislike_removed_comment') {
                // This means a dislike was removed from a comment
                const currentDislikeCount = Number(commentDislikeCount.textContent);
                const newDislikeCount = currentDislikeCount - 1;
                commentDislikeCount.textContent = newDislikeCount;
                commentDislikeButton.classList.remove("reaction-color");
                return;
              }

              if (data.reaction_type === 'dislike_updated') {
                // This means the user switched from like to dislike
                const currentLikeCount = Number(likeCount.textContent);
                const newLikeCount = currentLikeCount - 1;
                likeCount.textContent = newLikeCount;
                likeButton.classList.remove("reaction-color");

                const currentDislikeCount = Number(dislikeCount.textContent);
                const newDislikeCount = currentDislikeCount + 1;
                dislikeCount.textContent = newDislikeCount;
                dislikeButton.classList.add("reaction-color");
                return;
              }
              if (data.reaction_type !== 'dislike') {
                // This means a dislike was removed
                const currentDislikeCount = Number(dislikeCount.textContent);
                const newCount = currentDislikeCount - 1;
                dislikeCount.textContent = newCount;
                dislikeButton.classList.remove("reaction-color");
                return;
              }
              // This means a dislike was added
              const currentDislikeCount = Number(dislikeCount.textContent);
              const newCount = currentDislikeCount + 1;
              dislikeCount.textContent = newCount;
              dislikeButton.classList.add("reaction-color");
            }
          }
        } catch (err) {
          console.error("Error handling reaction:", err);
        }
      }
    function readNotifications() {
      const notificationCountContainer = document.getElementById("notificationCountContainer");
      const notificationCount = notificationCountContainer?.textContent?.trim();
      if(notificationCount === "0") {
        const NotificationListItems = document.querySelectorAll(".notification-link");
        //remove the unread indicator from the bell icon
        NotificationListItems.forEach(item => item.classList.remove("unread-indicator"));
      };
      const notificationCountElement = document.getElementById("notificationCountText");
      notificationCountElement.textContent = "0";
      notificationCountContainer.className = "notification-count-container-hidden";
    }
    async function checkNotifications() {
      console.log("Checking notifications...");
      const response = await fetch("http://localhost:3000/notifications", {
        method: "GET",
        headers: {
          "Content-Type": "application/json",
        },
      });
      const data = await response.json();
      const getNotificationsSection = document.getElementById("notificationsDropdown");
      const notificationCountElement = document.getElementById("notificationCountText");
      const notificationCountContainer = document.getElementById("notificationCountContainer");
      const getAllOtherUsersNotifications = data.notifications;

      notificationCountContainer.className = "notification-count-container";
      notificationCountElement.textContent = getAllOtherUsersNotifications.length;

       for (let otherUser of getAllOtherUsersNotifications) {
          const notification = otherUser;
          if(notification.notification_type === 'posts_down' ){
            const { likeComment, commentPost, replyPost, likePost, likeReply } = createTextForNotificationType(notification);
            createNotificationElement(notification, likeComment, commentPost, replyPost, likePost, likeReply, getNotificationsSection);
          }
          if(notification.notification_type === 'comments_down' ){
            const { likeComment, commentPost, replyPost, likePost, likeReply } = createTextForNotificationType(notification);
            createNotificationElement(notification, likeComment, commentPost, replyPost, likePost, likeReply, getNotificationsSection);
          }
          if(notification.notification_type === 'replies_down' ){
            const {  likeComment, commentPost, replyPost, likePost, likeReply  } = createTextForNotificationType(notification);
            createNotificationElement(notification, likeComment, commentPost, replyPost, likePost, likeReply, getNotificationsSection);
          }
       }
    }

  document.addEventListener("DOMContentLoaded", async () => {
    const list = <%- JSON.stringify(listAllContent) %>;
    if (!Array.isArray(list) || list.length === 0) return;
    listPosts(list);
    const response = await fetch("http://localhost:3000/check-notifications-reloaded", {
      method: "GET",
      headers: {
        "Content-Type": "application/json",
      },
    });
    const data = await response.json();
    const getAllOtherUsersNotifications = data.notifications;
    if (getAllOtherUsersNotifications.length > 0) {
      const NotificationListItems = document.querySelectorAll(".notification-link");
      return;
    }
    await checkNotifications();
  });
  function createTextForNotificationType(notification) {
    if (notification.notification_type === 'posts_down') {
      // Determine the notification message based on the type of reaction or reply
      const likePost = (notification.reaction_type && notification.post_id) ? `${notification.user_name} ${notification.reaction_type}d your post` : '';
      const likeComment = (notification.reaction_type && notification.comment_id ) ? `${notification.user_name} ${notification.reaction_type}d your comment` : '';
      const likeReply = (notification.reaction_type && notification.reply_id) ? `${notification.user_name} ${notification.reaction_type}d your reply` : '';
      const commentPost = (!notification.reaction_type && notification.post_id) ? `${notification.user_name} commented on your post` : '';
      const replyPost = (!notification.reaction_type && notification.comment_id) ? `${notification.user_name} replied to your comment` : '';
      return {likePost, likeComment, likeReply, commentPost, replyPost,};
    } else if (notification.notification_type === 'comments_down') {
        const likeComment = (notification.reaction_type && notification.comment_id) ? `${notification.user_name} ${notification.reaction_type}d your comment` : '';
         const likeReply = (notification.reaction_type && notification.reply_id) ? `${notification.user_name} ${notification.reaction_type}d your reply` : '';
        const commentPost = (!notification.reaction_type && notification.comment_id) ? `${notification.user_name} replied to your comment` : '';

        const likePost = null; // No likePost for comments_down
        const replyPost = null; // No replyPost for comments_down
        return {likePost, likeComment, likeReply, commentPost, replyPost};
    } else if (notification.notification_type === 'replies_down') {
        const likeReply = (notification.reaction_type && notification.reply_id) ? `${notification.user_name} ${notification.reaction_type}d your reply` : '';
        const likeComment = null; // No likeComment for replies_down
        const commentPost = null; // No commentPost for replies_down
        const likePost = null; // No likePost for replies_down
        const replyPost = null; // No replyPost for replies_down
      return {likePost, likeComment,likeReply, commentPost, replyPost };
    }
    return '';

  }
  function createNotificationElement(notification, likeComment, commentPost, replyPost, likePost, likeReply, getNotificationsSection) {
    const notificationMessage = document.createElement("p");
    // Set the content of the notification elements
    notificationMessage.textContent = likeComment || commentPost || replyPost || likePost || likeReply;
    // Calculate the time difference in minutes
    const minutesAgo = Math.floor((new Date() - new Date(notification.created_at)) / 60000);
    // Create the notification elements
    const notificationListItem = document.createElement("li");
    notificationListItem.className = 'nav-item notification-link unread-indicator';
    const notificationLink = document.createElement("a");
    const profileIcon = document.createElement("figure");
    const profilePost = document.createElement("div");
    const unreadIndicator = document.createElement("figure");
    const timeAgoContainer = document.createElement("div");
    const notificationTime = document.createElement("p");
    notificationTime.textContent = minutesAgo < 1 ? "Just now" : minutesAgo === 1 ? "1 minute ago" : minutesAgo < 60 ? `${minutesAgo} minutes ago` : minutesAgo < 1440 ? `${Math.floor(minutesAgo / 60)} hours ago` : `${Math.floor(minutesAgo / 1440)} days ago`;
    //notificationLink.href = `/forum/${n.id}`;
    notificationLink.className = 'nav-link';
    notificationTime.className = 'notification-time';
    notificationMessage.className = 'notification-message';
    profileIcon.className = 'profile-icon';
    profilePost.className = 'profile-post';
    profileIcon.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg"  fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16"><path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/><path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10.5 8 10.5s4.757.726 5.468-2.13A7 7 0 0 0 8 1z"/></svg>`;
    // Append the notification elements to the DOM
    profilePost.appendChild(profileIcon)
    profilePost.appendChild(notificationMessage)
    getNotificationsSection.appendChild(notificationListItem).appendChild(notificationLink).appendChild(profilePost)
    notificationLink.appendChild(timeAgoContainer).appendChild(notificationTime)
  }
</script>
