<script>
  function scrollToForumContent() {
    const forumAnchor = document.getElementById("anchor25");
    if (!forumAnchor) return;
    forumAnchor.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  async function handlePagination(page) {
    const offset = (Number(page) - 1) * 4; // Assuming 4 posts per page
    try {
      const response = await fetch(`http://localhost:3000/forumpagination?page=${page}&offset=${offset}`);
      const data = await response.json();
      // Update the active page button styling
      document.querySelectorAll(".unstyledPaginationButtons").forEach((button) => {
        button.textContent = button.textContent.trim();
        button.classList.toggle("selected", button.textContent === page);
      });
      listPosts(data.listAllContent);
      scrollToForumContent();
    } catch (err) {
      console.error("Error fetching paginated posts:", err);
    }

  }
    async function handlePostSubmit(username) {
      const textarea = document.querySelector(".forum-compose-input");
      const postContent = textarea.value.trim();
      if (!postContent) return;

      try {
        const response = await fetch("http://localhost:3000/add-post", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ newPost: postContent }),
        });
        const data = await response.json();
        if (data.success) {
          textarea.value = "";
          const newPost = data.post;
          // Prepend the new post to the list of posts
          const postsContainer = document.querySelector("#demo");
          const created = new Date(newPost.created_at);
          const day = created.getDate().toString().padStart(2, "0");
          const month = created.toLocaleString("default", { month: "short" }); // e.g. 'Mar'
