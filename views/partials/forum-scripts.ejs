                  <span style="color: #6e9731">  ${p.display_name} </span>
                </p>
                <p style="color: white" class="forum-post-date">
                   ${day}  ${month}  ${year}  at  ${time}  ${timeZone}
                </p>

                <div
                  style="display: flex; align-items: center"
                  class="forum-post-actions"
                >
                  <form onsubmit="handleReaction(${p.id}, null, null, 'like'); return false;">
                    <input type="hidden" name="post_id" value="${p.id}" />
