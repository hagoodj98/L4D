<script>
  $(".reply").on("click", function () {
    var postId = $(this)
      .closest(".forum-post-card")
      .find("input[name='post_id']")
      .val();
    $("#replyInputBox" + postId).toggle();
  });

  $(".comment").on("click", function () {
    var commentId = $(this)
      .closest(".forum-post-card")
      .find("input[name='post_id']")
      .val();
    $("#commentInputBox" + commentId).toggle();
  });
</script>

<script>
      let likes = 0;
      let dislikes = 0;
      let commentLikes = 0;
    let commentDislikes = 0;
        async function ascendForum() {
      try {
        const response = await fetch("http://localhost:3000/ascend");
        const data = await response.json();
        listPosts(data.listAllContent);
      } catch (err) {
        console.error("Error sorting posts:", err);
      }
    }
    async function descendForum() {
      try {
        const response = await fetch("http://localhost:3000/descend");
        const data = await response.json();
        listPosts(data.listAllContent);
      } catch (err) {
        console.error("Error sorting posts:", err);
      }
    }
    async function listPosts(listAllContents) {
      let content = "";
      for (let c of listAllContents) {
        likes += Number(c.likes);
        dislikes += Number(c.dislikes);
        commentLikes += Number(c.comment_likes);
        commentDislikes += Number(c.comment_dislikes);
        const created = new Date(c.created_at);
        const day = created.getDate().toString().padStart(2, "0");
        const month = created.toLocaleString("default", { month: "short" }); // e.g. 'Mar'
        const year = created.getFullYear();
        const timeZone = created
          .toLocaleTimeString("default", { timeZoneName: "short" })
          .split(" ")[2]; // e.g. 'PST'
        const time = created.toLocaleTimeString("default", {
          hour: "2-digit",
          minute: "2-digit",
        });
        content += `<div class="forum-post-card" style="border-bottom: 1px solid white">
              <!--
                    <textarea  class="textareapost autoresizing" style="  width: 100%;"  readonly  id="title/textarea>-->
              <p style="color: white" class="forum-post-content">
                 ${c.post}
              </p>
              <!--id="title<%#=post.id%>"-->
              <p style="color: white" class="forum-post-meta">
                Posted By:
                <span style="color: #6e9731">  ${c.display_name} </span>
              </p>
              <p style="color: white" class="forum-post-date">
                 ${day}  ${month}  ${year}  at  ${time}  ${timeZone}
              </p>

              <div
                style="display: flex; align-items: center"
                class="forum-post-actions"
              >
                <form onsubmit="handleReaction(${c.id}, null, 'like'); return false;">
                  <input type="hidden" name="post_id" value=" ${c.id} " />
                  <input type="hidden" name="reaction_type" value="like" />
                  <button
                    id="likeButton ${c.id}"
                    class="postButton  ${c.user_reaction === "like" ? "reaction-color" : ""} "
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                    >
                      <path
                        fill="currentColor"
                        d="M13.12 2.06L7.58 7.6c-.37.37-.58.88-.58 1.41V19c0 1.1.9 2 2 2h9c.8 0 1.52-.48 1.84-1.21l3.26-7.61C23.94 10.2 22.49 8 20.34 8h-5.65l.95-4.58c.1-.5-.05-1.01-.41-1.37c-.59-.58-1.53-.58-2.11.01M3 21c1.1 0 2-.9 2-2v-8c0-1.1-.9-2-2-2s-2 .9-2 2v8c0 1.1.9 2 2 2"
                      ></path>
                    </svg>
                  </button>
                </form>
                <span id="likeCount ${c.id}" style="color: white"> ${likes} </span>
                <form onsubmit="handleReaction(${c.id}, null, 'dislike'); return false;">
                  <input type="hidden" name="post_id" value=" ${c.id} " />
                  <input type="hidden" name="reaction_type" value="dislike" />
                  <button
                    id="dislikeButton ${c.id} "
                    class="postButton ${c.user_reaction === "dislike" ? "reaction-color" : ""} "
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                    >
                      <path
                        fill="currentColor"
                        d="M3.616 15q-.627 0-1.122-.494T2 13.385v-1.231q0-.137.028-.298q.028-.162.084-.298l2.73-6.473q.206-.462.693-.773Q6.02 4 6.538 4h8.192q.671 0 1.143.472t.472 1.143v8.714q0 .323-.133.628t-.351.522l-5.156 5.112q-.221.215-.493.27t-.517-.059t-.35-.373t-.04-.579l1.03-4.85zM19.385 4q.67 0 1.143.472q.472.472.472 1.144v7.769q0 .67-.472 1.143q-.472.472-1.143.472h-.423q-.671 0-1.144-.472t-.472-1.144V5.597q0-.671.472-1.133Q18.291 4 18.962 4z"
                      ></path>
                    </svg>
                  </button>
                </form>
                <span id="dislikeCount ${c.id}" style="color: white"> ${dislikes} </span>
                <button
                  id="commentButton ${c.id} "
                  class="comment postButton  ${c.user_reaction === "comment" ? "reaction-color" : ""} "
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                  >
                    <path
                      fill="currentColor"
                      d="M11.953 2.25c-2.317 0-4.118 0-5.52.15c-1.418.153-2.541.47-3.437 1.186c-.92.736-1.35 1.693-1.553 2.9c-.193 1.152-.193 2.618-.193 4.446v.183c0 1.782 0 3.015.2 3.934c.108.495.278.925.545 1.323c.264.392.6.722 1.001 1.042c.631.505 1.375.81 2.254 1V21a.75.75 0 0 0 1.123.65c.586-.335 1.105-.7 1.58-1.044l.304-.221a22 22 0 0 1 1.036-.73c.844-.548 1.65-.905 2.707-.905h.047c2.317 0 4.118 0 5.52-.15c1.418-.153 2.541-.47 3.437-1.186c.4-.32.737-.65 1-1.042c.268-.398.438-.828.546-1.323c.2-.919.2-2.152.2-3.934v-.183c0-1.828 0-3.294-.193-4.445c-.203-1.208-.633-2.165-1.553-2.901c-.896-.717-2.019-1.033-3.437-1.185c-1.402-.151-3.203-.151-5.52-.151z"
                    ></path>
                  </svg>
                </button>
                <span id="commentLikeCount ${c.id}" style="color: white"> ${commentLikes} </span>
                <button
                  id="replyButton ${c.id} "
                  class="reply roboto-condensed"
                >
                  Reply
                </button>
              </div>
              <div
                id="replyInputBox ${c.id} "
                style="display: none"
                class="forum-reply-editor-wrap"
              >
                <form action="/add-reply" method="post">
                  <input type="hidden" name="post_id" value=" ${c.id} " />
                  <div
                    style="display: flex; flex-direction: column"
                    class="forum-reply-editor"
                  >
                    <textarea
                      rows="9"
                      style="
                        background-color: #0d0d0d;
                        color: white;
                        padding: 10px;
                      "
                      class="forum-reply-input"
                      autofocus="true"
                      name="reply"
                      placeholder="Write a reply..."
                      required
                    ></textarea>

                    <button type="submit">Submit</button>
                  </div>
                </form>
              </div>
              <div id="commentInputBox ${c.id} " style="display: none">
                  ${c.replies
                    .map((reply) => {
                      return `
                   <div
                  class="p-2 forum-reply-card"
                  style="border-top: 1px solid white; margin-left: 20px"
                >
                  <p style="color: white"> ${reply.comment_post} </p>
                  <p style="color: white">
                    Posted By:
                    <span style="color: #d83232">  ${reply.display_name} </span>
                  </p>
                  <p style="color: white"> ${reply.created_at} </p>
                </div>
                <div
                  class="forum-reply-actions"
                  style="display: flex; align-items: center; margin-left: 20px"
                >
                  <form onsubmit="handleReaction(null, ${reply.id}, 'like'); return false;">
                    <input
                      type="hidden"
                      name="comment_post_id"
                      value=" ${reply.id} "
                    />
                    <input type="hidden" name="reaction_type" value="like" />
                    <button
                      class="postButton  ${reply.user_reaction === "like" ? "reaction-color" : ""} "
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                      >
                        <path
                          fill="currentColor"
                          d="M20.385 9q.627 0 1.12.494T22 10.616v1.23q0 .137-.028.298q-.028.162-.083.298l-2.731 6.474q-.206.461-.693.773q-.486.311-1.003.311H9.269q-.671 0-1.143-.472t-.472-1.144V9.672q0-.323.133-.628t.351-.522l5.156-5.112q.222-.215.494-.27t.516.059t.35.373q.108.258.04.579L13.665 9zM4.615 20q-.67 0-1.143-.472Q3 19.056 3 18.385v-7.77q0-.67.472-1.143Q3.944 9 4.616 9h.423q.67 0 1.143.472q.472.472.472 1.144v7.788q0 .671-.472 1.133Q5.71 20 5.039 20z"
                        ></path>
                      </svg>
                    </button>
                    <span style="color: white"> ${commentLikes} </span>
                  </form>

                  <form onsubmit="handleReaction(null, ${reply.id}, 'dislike'); return false;">
                    <input
                      type="hidden"
                      name="comment_post_id"
                      value=" ${reply.id} "
                    />
                    <input
                      type="hidden"
                      name="reaction_type"
                      value="dislike"
                    />
                    <button
                      class="postButton  ${reply.user_reaction === "dislike" ? "reaction-color" : ""} "
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                      >
                        <path
                          fill="currentColor"
                          d="M3.616 15q-.627 0-1.122-.494T2 13.385v-1.231q0-.137.028-.298q.028-.162.084-.298l2.73-6.473q.206-.462.693-.773Q6.02 4 6.538 4h8.192q.671 0 1.143.472t.472 1.143v8.714q0 .323-.133.628t-.351.522l-5.156 5.112q-.221.215-.493.27t-.517-.059t-.35-.373t-.04-.579l1.03-4.85zM19.385 4q.67 0 1.143.472q.472.472.472 1.144v7.769q0 .67-.472 1.143q-.472.472-1.143.472h-.423q-.671 0-1.144-.472t-.472-1.144V5.597q0-.671.472-1.133Q18.291 4 18.962 4z"
                        ></path>
                      </svg>
                    </button>
                    <span style="color: white"> ${commentDislikes} </span>
                  </form>
                </div>
              </div>
            </div>`;
                    })
                    .join(" ")}
              </div>
            </div>`;
      }

      document.querySelector(".posts").innerHTML = content;
    }
  async function handleReaction(postId, commentId, reactionType) {
      try {
        const response = await fetch("http://localhost:3000/post-reaction", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            post_id: postId ?? null,
            comment_post_id: commentId ?? null,
            reaction_type: reactionType,
          }),
        });
        const data = await response.json();
        // Update the UI based on the new reaction state
        if (data.reaction_type) {
          const button = document.getElementById(`likeButton ${postId}`);
          const likeCount = document.getElementById(`likeCount ${postId}`);
          const dislikeCount = document.getElementById(`dislikeCount ${postId}`);
          if (data.reaction_type === "like" || data.reaction_type === 'like_removed') {
            if (data.reaction_type !== 'like') {
                likes -= 1;
                likeCount.textContent = likes;
               button.classList.remove("reaction-color");
               return;
            }
            likes += 1;
            likeCount.textContent = likes;
            button.classList.add("reaction-color");
          } else if (data.reaction_type === "dislike" || data.reaction_type === 'dislike_removed') {
            const dislikeButton = document.getElementById(`dislikeButton ${postId}`);
            if (data.reaction_type !== 'dislike') {
                dislikes -= 1;
               dislikeButton.classList.remove("reaction-color");
            }
            dislikeButton.classList.add("reaction-color");
            dislikes += 1;
            dislikeCount.textContent = dislikes;
          }
        }
      } catch (err) {
        console.error("Error handling reaction:", err);
      }
    }
    document.addEventListener("DOMContentLoaded", () => {
      const list = <%- JSON.stringify(listAllContent) %>;
      if (!Array.isArray(list) || list.length === 0) return;

      listPosts(list);
    });
</script>
