                      type="hidden"
                      name="comment_post_id"
                      value="${newReply.id}"
                    />
                    <input
                      type="hidden"
                      name="reaction_type"
                      value="dislike"
                    />
                    <button
                      id="replyDislikeButton-${newReply.id}"
                      class="postButton"
