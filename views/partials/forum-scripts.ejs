    function toggleReplyBox(id) {
        const replyBox = document.getElementById(`replyInputBox-${id}`);
        replyBox.style.display = replyBox.style.display === "none" ? "block" : "none";
    }
    function showAllReplies(id, replied = false) {
      const replySection = document.getElementById(`commentInputBox-${id}`);
      if (replied) {
        if (replySection.style.display === "block") {
          return;
        } else {
          replySection.style.display = "block";
          return;
        }
      }
      replySection.style.display = replySection.style.display === "none" ? "block" : "none";
    }
    async function handleReplySubmit(postId, username) {
