<%- include("partials/header.ejs") %>

<div style="height: auto">
  <div class="container d-flex flex-column">
    <div id="anchor25" class="paddingtop">
      <div class="forum-intro-wrap">
        <% if (isAuthenticated) { %>
        <p style="color: white" class="forum-intro">
          Welcome to the forum,
          <span style="color: #d83232"><%= currentUser %></span>! Feel free to
          share your thoughts and opinions about the game, ask questions, or
          just connect with other fans. Please remember to be respectful and
          follow our community guidelines while participating in the
          discussions. Happy gaming!
        </p>
        <% } %>

        <% if (!isAuthenticated) { %>
        <div
          class="forum-guest-cta"
          style="
            border: 1px solid #d83232;
            padding: 12px;
            margin-bottom: 12px;
            color: white;
          "
        >
          Browse all posts as a guest. To create posts, react, or reply,
          <a href="/login" style="color: #d83232">log in</a>
          or
          <a href="/register" style="color: #d83232">create an account</a>.
        </div>
        <% } %>

        <% if (isAuthenticated) { %>
        <form
          onsubmit="
            handlePostSubmit('<%= currentUser %>');
            return false;
          "
          class="forum-compose-form"
        >
          <textarea
            name="newPost"
            class="textareapost autoresizing forum-compose-input"
            placeholder="Write your post here..."
            required
          ></textarea>
          <button type="submit" class="postButton forum-submit-post">
            Submit Post
          </button>
        </form>
        <% } %>
      </div>
      <div id="forumSortControls" style="color: white"></div>
      <div class="d-flex forum-sort-controls" style="margin-right: auto">
        <form onSubmit="ascendForum(); return false;">
          <button
            type="submit"
            name="recentPostByTime"
            style="background-color: transparent"
            class="navforummavbutton roboto-condensed forum-sort-btn"
          >
            Latest Post
          </button>
        </form>

        <form onSubmit="descendForum(); return false;">
          <button
            type="submit"
            name="oldestPostByTime"
            style="background-color: transparent"
            class="navforummavbutton roboto-condensed forum-sort-btn"
          >
            Oldest Post
          </button>
        </form>
      </div>
      <div class="d-flex flex-column forum-content-wrap">
        <div id="demo" class="posts forum-post-list"></div>
      </div>
    </div>
  </div>
  <nav aria-label="Page navigation example">
    <ul class="pagination justify-content-end" id="paginationControls">
      <li class="page-item">
        <button
          class="page-link"
          onclick="
            handlePagination(currentPage - 1);
            return false;
          "
          type="button"
          aria-label="Previous"
        >
          <span aria-hidden="true">&laquo;</span>
        </button>
      </li>
      <% const maxPagination = maxPage ?? 10; %>
      <% const minPagination = minPage ?? 1; %>
      <% for (let index = 1; index <= paginationNumber; index++) { %>
      <% if(index > 10) continue; %>
      <li class="page-item">
        <button
          class="page-link unstyledPaginationButtons"
          type="button"
          onclick="handlePagination(<%= index %>)"
        >
          <%= index %>
        </button>
      </li>
      <% } %>
      <li class="page-item">
        <button
          onclick="
              handlePaginationIncrease(
                <%= maxPagination %>,
                <%= minPagination %>,
                <%= paginationNumber %>
              );
              return false;
            "
          class="page-link"
          type="button"
          aria-label="Next"
        >
          <span aria-hidden="true">&raquo;</span>
        </button>
      </li>
    </ul>
  </nav>
</div>

<%- include("partials/footer.ejs") %>
<%- include("partials/forum-scripts.ejs", { listAllContent, user: currentUser, paginationNumber, minPage, maxPage }) %>
