<%- include("partials/header.ejs") %>

<div style="height: auto">
  <div class="container d-flex flex-column">
    <div id="anchor/<%= page %>" class="paddingtop">
      <div class="forum-intro-wrap">
        <% if (isAuthenticated) { %>
        <p style="color: white" class="forum-intro">
          Welcome to the forum,
          <span style="color: #d83232"><%= currentUser %></span>! Feel free to
          share your thoughts and opinions about the game, ask questions, or
          just connect with other fans. Please remember to be respectful and
          follow our community guidelines while participating in the
          discussions. Happy gaming!
        </p>
        <% } %>

        <% if (!isAuthenticated) { %>
        <div
          class="forum-guest-cta"
          style="
            border: 1px solid #d83232;
            padding: 12px;
            margin-bottom: 12px;
            color: white;
          "
        >
          Browse all posts as a guest. To create posts, react, or reply,
          <a href="/auth/login" style="color: #d83232">log in</a>
          or
          <a href="/auth/register" style="color: #d83232">create an account</a>.
        </div>
        <% } %>

        <% if (isAuthenticated) { %>
        <form
          onsubmit="
            handlePostSubmit('<%= currentUser %>');
            return false;
          "
          class="forum-compose-form"
        >
          <textarea
            name="newPost"
            class="textareapost autoresizing forum-compose-input"
            placeholder="Write your post here..."
            required
          ></textarea>
          <button type="submit" class="postButton forum-submit-post">
            Submit Post
          </button>
        </form>
        <% } %>
      </div>
      <div id="forumSortControls" style="color: white"></div>
      <div class="d-flex forum-sort-controls" style="margin-right: auto">
        <form onSubmit="ascendForum(); return false;">
          <button
            type="submit"
            name="recentPostByTime"
            style="background-color: transparent"
            class="navforummavbutton roboto-condensed forum-sort-btn"
          >
            Latest Post
          </button>
        </form>

        <form onSubmit="descendForum(); return false;">
          <button
            type="submit"
            name="oldestPostByTime"
            style="background-color: transparent"
            class="navforummavbutton roboto-condensed forum-sort-btn"
          >
            Oldest Post
          </button>
        </form>
      </div>
      <div class="d-flex flex-column forum-content-wrap">
        <div id="demo" class="posts forum-post-list"></div>
      </div>
      <span
        id="paginationInfo"
        class="forum-pagination-info"
        style="color: white"
      >
      </span>
      <nav aria-label="Page navigation example">
        <ul class="pagination" id="paginationControls">
          <li class="page-item">
            <button
              class="page-link"
              id="paginationDecrease"
              onclick="
            handlePaginationIncrements(
              <%= paginationNumber %>,
              'decrease'
            );
              return false;
            "
              type="button"
              value="1"
              aria-label="Previous"
            >
              <span aria-hidden="true">&laquo;</span>
            </button>
          </li>
          <% for (let i = 1; i <= paginationNumber; i++) { %>
          <li class="page-item">
            <button
              class="page-link unstyledPaginationButtons"
              type="button"
              href="<%= i %>"
              id="paginationButton<%= i %>"
              style="display: <%= i < page || i > page + 9 ? 'none' : 'inline-block' %>;"
              onclick="handlePagination(<%= i %>)"
            >
              <%=i%>
            </button>
          </li>
          <% } %>
          <li class="page-item">
            <button
              id="paginationIncrease"
              onclick="
              handlePaginationIncrements(
                <%= paginationNumber %>,
                'increase'
              );
              return false;
            "
              class="page-link"
              type="button"
              aria-label="Next"
              value="10"
            >
              <span aria-hidden="true">&raquo;</span>
            </button>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</div>

<%- include("partials/footer.ejs") %>
<%- include("partials/forum.ejs", { listAllContent, paginationNumber }) %>
