{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "index.ts",
    "database/**/*",
    "utils/**/*",
    "passport/**/*",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", "tests", "e2e"]
}
