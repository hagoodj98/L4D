SELECT 
    posts.id,
    posts.post,
    COALESCE(likes_to_posts.reaction_to_post, '[]'::json) AS reactions_to_post,
    COALESCE(likes_to_replies.reaction_to_replies, '[]'::json) AS reactions_to_replies,
    COALESCE(likes_to_subreplies.reaction_to_subreplies, '[]'::json) AS reactions_to_sub_replies,
    COALESCE(other_replies_to_post.replies, '[]'::json) AS replies,
    COALESCE(other_replies_to_replies.replies, '[]'::json) AS sub_replies
    FROM posts
    LEFT JOIN LATERAL (
        SELECT
            post_id,
            json_agg(
                json_build_object(
                    'user_name', users.display_name,
                    'reaction_type', reaction_type,
                 'created_at', created_at,
                    'post_id', post_id
                )
            ) AS reaction_to_post FROM posts_reactions
            LEFT JOIN users ON posts_reactions.user_id = users.id
            WHERE posts_reactions.post_id = posts.id
            GROUP BY post_id
    ) likes_to_posts ON true
    LEFT JOIN LATERAL (
        SELECT 
            comment_id,
            json_agg(
                json_build_object(
                    'user_name', users.display_name,
                    'reaction_type', reaction_type,
                    'created_at', created_at,
                    'comment_id', comment_id
                )
            ) AS reaction_to_replies FROM reactions_comments
            LEFT JOIN users ON reactions_comments.user_id = users.id
            WHERE reactions_comments.user_id = 42 AND reactions_comments.comment_id IN (
                SELECT id FROM replies WHERE replies.post_id = posts.id
            )
            GROUP BY comment_id
    ) likes_to_replies ON true
    LEFT JOIN LATERAL (
        SELECT
            reply_id,
            json_agg(
                json_build_object(
                    'user_name', users.display_name,
                    'reaction_type', reaction_type,
                    'created_at', created_at,
                    'reply_id', reply_id
                )
            ) AS reaction_to_subreplies FROM reactions_to_finalreply
            LEFT JOIN users ON reactions_to_finalreply.user_id = users.id
            WHERE reactions_to_finalreply.user_id = 42 AND reactions_to_finalreply.reply_id IN (
                SELECT id FROM replies_final_tier WHERE replies_final_tier.reply_id IN (
                    SELECT id FROM replies WHERE replies.post_id = posts.id
                )
            )
            GROUP BY reply_id
    ) likes_to_subreplies ON true
    LEFT JOIN LATERAL (
        SELECT
            post_id,
            json_agg(
                json_build_object(
                    'user_name', users.display_name,
                    'reply', comment_post,
                    'created_at', created_at,
                    'post_id', post_id
                )
            ) AS replies from replies
            LEFT JOIN users ON replies.user_id = users.id
            WHERE replies.post_id = posts.id
            GROUP BY post_id
    ) other_replies_to_post ON true
    LEFT JOIN LATERAL (
        SELECT
            reply_id,
            json_agg(
                json_build_object(
                    'user_name', users.display_name,
                    'sub_reply', comment_post,
                    'created_at', created_at,
                    'reply_id', reply_id
                )
            ) AS replies FROM replies_final_tier
            LEFT JOIN users ON replies_final_tier.user_id = users.id
            WHERE replies_final_tier.user_id = 42 AND replies_final_tier.reply_id IN (
                SELECT id FROM replies WHERE replies.post_id = posts.id
            )
            GROUP BY reply_id
    ) other_replies_to_replies ON true
    WHERE posts.user_id = 42 AND likes_to_posts.reaction_to_post IS NOT NULL AND other_replies_to_post.replies IS NOT NULL;